# AstroRize Vedic Research Lab - Configuration
APP_NAME="TEST Vedic Research Lab"
APP_ENV=development
PORT=8000
HOST=127.0.0.1

# Database
DATABASE_URL=sqlite:///./astrorize_lab.db

# Swiss Ephemeris
SWE_EPHE_PATH=./app/ephe
DEFAULT_AYANAMSA=LAHIRI
DEFAULT_NODE_CALC=TRUE_NODE
DEFAULT_HOUSE_SYSTEM=WHOLE_SIGN

# Local AI / LLM Configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest
LLM_PROVIDER=ollama
LLM_TEMPERATURE=0.2
LLM_CONTEXT_LENGTH=4096
AI_FALLBACK_RULE_BASED=true
